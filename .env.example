# Copy this file to .env and fill in the key. .env is git-ignored.
GROQ_API_KEY=gsk_your_key_here

# Any OpenAI-compatible endpoint works. Defaults are Groq.
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=qwen/qwen3.8-27b

# Optional: a second model just for picking tables (separate rate-limit budget on Groq)
LLM_SELECT_MODEL=openai/gpt-oss-20b
LLM_SELECT_REASONING=low

# To run fully local with Ollama instead:
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=qwen2.5-coder:7b
# GROQ_API_KEY=ollama
